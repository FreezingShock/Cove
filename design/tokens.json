{
  "_about": "Single source for corner radius and motion, shared by the Swift app (Inlet/InletTheme.swift) and the website (website/css/tokens.css). Edit this file, then run: python3 scripts/build-tokens.py. CI runs it with --check.",
  "radius": {
    "_about": "Points in the app, CSS px on the site. Radii nest: inner = outer - inset (Apple ConcentricRectangle rule). Use the scale names; never a raw number.",
    "scale": {
      "xs": 6,
      "sm": 10,
      "md": 16,
      "lg": 20,
      "row": 24,
      "sidebar": 18,
      "window": 26,
      "panel": 32
    },
    "pill": 999,
    "hair": 2,
    "iconRatio": 0.224,
    "nesting": [
      { "inner": "row", "outer": "panel", "inset": 8, "use": "selected row inside a results panel" },
      { "inner": "md", "outer": "panel", "inset": 16, "use": "group or row inside a panel with 16 pt padding" },
      { "inner": "lg", "outer": "panel", "inset": 12, "use": "card inside a panel with 12 pt padding" },
      { "inner": "sidebar", "outer": "window", "inset": 8, "use": "Settings sidebar inside the window" },
      { "inner": "sm", "outer": "sidebar", "inset": 8, "use": "sidebar row" },
      { "inner": "xs", "outer": "sm", "inset": 4, "use": "keycap or symbol tile inside a small tile" }
    ]
  },
  "motion": {
    "_about": "Durations in seconds. Springs use Spring(duration:bounce:) and match SwiftUI's model: bounce 0 is critically damped, bounce b gives damping ratio 1 - b. The website gets the same curve as a CSS linear() easing.",
    "durations": {
      "fast": 0.2,
      "base": 0.26,
      "medium": 0.36,
      "slow": 0.5,
      "slower": 0.8,
      "jiggle": 0.19,
      "blink": 1.0
    },
    "easing": {
      "standard": [0.2, 0.8, 0.2, 1],
      "exit": [0.4, 0, 1, 1],
      "fade": [0.25, 0.1, 0.25, 1],
      "inOut": [0.42, 0, 0.58, 1]
    },
    "springs": {
      "snap":    { "duration": 0.24, "bounce": 0.0,  "use": "hover, selection move, focus ring" },
      "press":   { "duration": 0.26, "bounce": 0.42, "use": "icon and button press, release overshoot" },
      "open":    { "duration": 0.46, "bounce": 0.24, "use": "full grid appears, icons ripple out" },
      "morph":   { "duration": 0.52, "bounce": 0.30, "use": "search capsule melts into the results panel" },
      "rise":    { "duration": 0.50, "bounce": 0.32, "use": "quick panel rises out of the Dock icon" },
      "settle":  { "duration": 0.60, "bounce": 0.18, "use": "grid reflow when a search filters icons" },
      "dismiss": { "duration": 0.26, "bounce": 0.0,  "use": "anything closing; never bounce on the way out" }
    }
  },
